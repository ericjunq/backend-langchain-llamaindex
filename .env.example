# Copie para .env e preencha. Nunca versione o .env.
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/gestao
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=7
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:4200"]
FUSO_HORARIO=America/Sao_Paulo
# Assistente local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen3:8b
# Emails de aviso: console (dev: só registra no log, mascarado) | smtp
EMAIL_BACKEND=console
EMAIL_REMETENTE=nao-responda@seudominio.com
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
# Retenção: intervalo da limpeza automática de dados vencidos (horas)
LIMPEZA_INTERVALO_HORAS=24
# Limite de login: falhas por IP+email dentro da janela
LOGIN_MAX_FALHAS=5
LOGIN_JANELA_MINUTOS=15
